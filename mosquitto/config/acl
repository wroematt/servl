# ─────────────────────────────────────────────
#  Mosquitto ACL
#
#  Internal service user — full access
#  Device clients — scoped to their own topic only
#
#  Device client ID format: device_<uuid>
#  Topics:
#    feeder/<deviceId>/cmd     server → device (commands)
#    feeder/<deviceId>/status  device → server (telemetry)
# ─────────────────────────────────────────────

# Internal service account (used by device-service and feed-service)
user internal_service
topic readwrite feeder/#

# Per-device ACL — each device can only read its own /cmd
# and write its own /status. The %c pattern substitutes
# the connecting client's ID at runtime.
pattern read  feeder/%c/cmd
pattern write feeder/%c/status
