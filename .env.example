# ─── Servl — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in every value before running docker compose.
# Never commit .env to git.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=servl
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=servl

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_byte_hex_string

# ─── Domain ───────────────────────────────────────────────────────────────────
# The public domain name used in password-reset and invite emails.
DOMAIN=https://app.servl.uk

# ─── SMTP (email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Servl <your@gmail.com>

# ─── MQTT ─────────────────────────────────────────────────────────────────────
# Credentials used by all backend services to talk to the Mosquitto broker.
# Must match the entry in mosquitto/config/passwd (generated during setup).
MQTT_INTERNAL_USER=internal_service
MQTT_INTERNAL_PASS=change_me_strong_password

# ─── OTA firmware downloads ───────────────────────────────────────────────────
# Publicly reachable URL that ESP32 devices (on the home LAN) can use to
# download firmware binaries. The backend now runs on an Oracle Cloud server —
# NOT on the same LAN as the devices — so this must be a public URL (e.g. the
# domain behind Cloudflare Tunnel / nginx), not a LAN IP.
OTA_BASE_URL=https://api.servl.uk

# ─── Google Home webhook ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_HOME_HMAC_SECRET=change_me_32_byte_hex_string

# ─── Google Home OAuth account linking ────────────────────────────────────────
# These are credentials YOU create — they are NOT from Google.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste both into the Google Actions Console under
#   Develop → Account linking → OAuth credentials (client ID / client secret).
# The authorization URL to enter in Actions Console: https://{DOMAIN}/oauth/authorize
# The token URL to enter in Actions Console:         https://{DOMAIN}/oauth/token
# Leave both blank to disable Google Home account-linking (HMAC webhook still works).
GOOGLE_HOME_OAUTH_CLIENT_ID=change_me_or_leave_blank
GOOGLE_HOME_OAUTH_CLIENT_SECRET=change_me_or_leave_blank

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
# From your Firebase project → Project Settings → Service Accounts → Generate key
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# Firebase Console → Authentication → Sign-in method → Google → Web SDK config
# Copy the "Web client ID" value here.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
