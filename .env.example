# ─────────────────────────────────────────────
#  PetFeeder — environment variables
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Domain (used by nginx + Cloudflare Tunnel)
DOMAIN=petfeeder.yourdomain.com

# PostgreSQL
POSTGRES_USER=petfeeder
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=petfeeder

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_byte_hex_string

# MQTT internal service credentials (server → broker)
MQTT_INTERNAL_USER=internal_service
MQTT_INTERNAL_PASS=change_me_mqtt_password

# Email (for password reset — use any SMTP provider, e.g. Brevo free tier)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@petfeeder.yourdomain.com

# Firebase Cloud Messaging (for push notifications)
# Get these from your Firebase project settings → Service accounts
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Home webhook HMAC secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_HOME_HMAC_SECRET=change_me_hmac_secret
