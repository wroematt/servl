# ─── Servl — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in every value before running docker compose.
# Never commit .env to git.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=servl
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=servl

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_byte_hex_string

# ─── Domain ───────────────────────────────────────────────────────────────────
# The public domain name used in password-reset and invite emails.
# e.g. https://app.yourdomain.com  (no trailing slash)
DOMAIN=https://your.domain.com

# ─── SMTP (email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Servl <your@gmail.com>

# ─── MQTT ─────────────────────────────────────────────────────────────────────
# Credentials used by all backend services to talk to the Mosquitto broker.
# Must match the entry in mosquitto/config/passwd (generated during setup).
MQTT_INTERNAL_USER=internal_service
MQTT_INTERNAL_PASS=change_me_strong_password

# ─── OTA firmware downloads ───────────────────────────────────────────────────
# LAN URL that ESP32 devices can reach to download firmware binaries.
# Set to http://<raspberry-pi-lan-ip>:3000  (find IP with: hostname -I)
OTA_BASE_URL=http://192.168.1.100:3000

# ─── Google Home webhook ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_HOME_HMAC_SECRET=change_me_32_byte_hex_string

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
# From your Firebase project → Project Settings → Service Accounts → Generate key
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
